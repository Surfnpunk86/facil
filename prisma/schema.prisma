// Fácil — modelo de datos del MVP (fase 1)
// Montos en pesos colombianos enteros (sin decimales).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Door {
  NFC
  QR
  WHATSAPP
  WALLET
  CASHIER
  DELIVERY_CODE
}

enum Validation {
  INVOICE
  CASHIER
  DELIVERY_CODE
}

enum StaffRole {
  OWNER
  CASHIER
}

enum RewardKind {
  STAMP_CARD
  BIRTHDAY
  ALBUM
}

enum RewardStatus {
  AVAILABLE
  REDEEMED
  EXPIRED
}

enum ChallengeKind {
  VISITS // número de compras validadas en el periodo
  SPEND // gasto acumulado en el periodo (pesos)
  STREAK_WEEKS // semanas seguidas con al menos una compra
}

enum DrawStatus {
  DRAFT
  ACTIVE
  CLOSED
  DRAWN
}

enum AutomationKey {
  WELCOME
  WINBACK
  BIRTHDAY
  NEAR_REWARD
  LOW_RATING
}

model Restaurant {
  id                 String   @id @default(cuid())
  slug               String   @unique
  name               String
  nit                String // solo dígitos, sin dígito de verificación
  city               String?
  pointsPerThousand  Int      @default(1) // puntos por cada $1.000 COP
  stampsGoal         Int      @default(8)
  rewardText         String   @default("Premio del Club")
  birthdayRewardText String   @default("Un detalle de cumpleaños por la casa")
  googleReviewUrl    String?
  ownerAlertPhone    String? // recibe alertas de calificaciones bajas
  maxClaimsPerDay    Int      @default(2) // compras validadas por cliente por día
  invoiceMaxAgeHours Int      @default(48)
  zoneId             String?
  zone               Zone?    @relation(fields: [zoneId], references: [id], onDelete: SetNull)
  createdAt          DateTime @default(now())

  staff         Staff[]
  tags          Tag[]
  customers     Customer[]
  purchases     Purchase[]
  deliveryCodes DeliveryCode[]
  feedback      Feedback[]
  automations   Automation[]
  entries       EntryEvent[]
  messages      MessageLog[]
  rewards       Reward[]
  waiters       Waiter[]
  challenges    Challenge[]
}

model Staff {
  id           String     @id @default(cuid())
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  name         String
  email        String     @unique
  passwordHash String
  role         StaffRole  @default(CASHIER)
  createdAt    DateTime   @default(now())
  purchases    Purchase[]
}

// Pieza física de mesa o caja: chip NFC + QR impreso con la misma URL.
model Tag {
  id           String       @id @default(cuid())
  restaurantId String
  restaurant   Restaurant   @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  code         String // ej. MESA-7, CAJA-1
  label        String?
  active       Boolean      @default(true)
  createdAt    DateTime     @default(now())
  entries      EntryEvent[]

  @@unique([restaurantId, code])
}

model Customer {
  id             String     @id @default(cuid())
  restaurantId   String
  restaurant     Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  name           String?
  phone          String // formato E.164, ej. +573005551234
  birthMonth     Int?
  birthDay       Int?
  consentAt      DateTime? // autorización Ley 1581; sin ella no se envía marketing
  consentVersion String?
  optOut         Boolean    @default(false)
  cardToken      String     @unique
  points         Int        @default(0)
  stamps         Int        @default(0)
  rewardsEarned  Int        @default(0)
  visits         Int        @default(0)
  totalSpent     Int        @default(0)
  firstVisitAt   DateTime?
  lastVisitAt    DateTime?
  joinedVia      Door?
  waiterId       String? // mesero que lo inscribió
  waiter         Waiter?    @relation(fields: [waiterId], references: [id], onDelete: SetNull)
  createdAt      DateTime   @default(now())

  purchases Purchase[]
  rewards   Reward[]
  feedback  Feedback[]
  entries   EntryEvent[]
  messages  MessageLog[]
  tickets   DrawTicket[]

  @@unique([restaurantId, phone])
  @@index([restaurantId, lastVisitAt])
}

model Purchase {
  id            String      @id @default(cuid())
  restaurantId  String
  restaurant    Restaurant  @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  customerId    String
  customer      Customer    @relation(fields: [customerId], references: [id], onDelete: Cascade)
  amount        Int
  door          Door
  validation    Validation
  invoiceKey    String? // CUFE o CUDE; evita que una factura se use dos veces
  invoiceNumber String?
  pointsAwarded Int
  stampAwarded  Boolean     @default(true)
  staffId       String?
  staff         Staff?      @relation(fields: [staffId], references: [id])
  createdAt     DateTime    @default(now())
  ticket        DrawTicket?

  @@unique([restaurantId, invoiceKey])
  @@index([restaurantId, createdAt])
  @@index([customerId, createdAt])
}

// Código impreso en empaques de domicilio: una compra, un uso.
model DeliveryCode {
  id           String     @id @default(cuid())
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  code         String     @unique
  amount       Int
  usedAt       DateTime?
  customerId   String?
  expiresAt    DateTime
  createdAt    DateTime   @default(now())
}

model Reward {
  id           String       @id @default(cuid())
  restaurantId String
  restaurant   Restaurant   @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  customerId   String
  customer     Customer     @relation(fields: [customerId], references: [id], onDelete: Cascade)
  kind         RewardKind
  description  String
  status       RewardStatus @default(AVAILABLE)
  expiresAt    DateTime?
  redeemedAt   DateTime?
  createdAt    DateTime     @default(now())

  @@index([customerId, status])
}

model Feedback {
  id           String     @id @default(cuid())
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  customerId   String?
  customer     Customer?  @relation(fields: [customerId], references: [id], onDelete: SetNull)
  rating       Int
  comment      String?
  handledAt    DateTime?
  createdAt    DateTime   @default(now())
}

model Automation {
  restaurantId String
  restaurant   Restaurant    @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  key          AutomationKey
  enabled      Boolean       @default(true)

  @@id([restaurantId, key])
}

// Cada identificación en una puerta (toque NFC, QR, WhatsApp…), con o sin compra.
model EntryEvent {
  id           String     @id @default(cuid())
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  customerId   String?
  customer     Customer?  @relation(fields: [customerId], references: [id], onDelete: SetNull)
  tagId        String?
  tag          Tag?       @relation(fields: [tagId], references: [id], onDelete: SetNull)
  door         Door
  createdAt    DateTime   @default(now())

  @@index([restaurantId, createdAt])
}

model MessageLog {
  id           String     @id @default(cuid())
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  customerId   String?
  customer     Customer?  @relation(fields: [customerId], references: [id], onDelete: SetNull)
  kind         String // WELCOME, WINBACK, BIRTHDAY, NEAR_REWARD, CARD_LINK, PURCHASE, LOW_RATING_ALERT, REPLY
  channel      String     @default("WHATSAPP")
  status       String // SENT, FAILED, SKIPPED_DEV
  providerId   String?
  error        String?
  createdAt    DateTime   @default(now())

  @@index([customerId, kind, createdAt])
}

// ---------- Red de beneficios y juegos ----------

// Zona de la red (una página del álbum): restaurantes cercanos que comparten álbum, retos y sorteos.
model Zone {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String // ej. "Ruta del Prado"
  city        String?
  rewardText  String   @default("Premio por completar la página del álbum")
  seasonStart DateTime // las láminas cuentan desde esta fecha
  seasonEnd   DateTime
  createdAt   DateTime @default(now())

  restaurants Restaurant[]
  completions AlbumCompletion[]
  challenges  Challenge[]
  draws       Draw[]
}

// Página del álbum completada por un cliente (identificado por su celular en toda la red).
model AlbumCompletion {
  id           String   @id @default(cuid())
  zoneId       String
  zone         Zone     @relation(fields: [zoneId], references: [id], onDelete: Cascade)
  phone        String
  seasonStart  DateTime
  restaurantId String // restaurante donde completó la página y donde se crea el premio
  rewardId     String?
  createdAt    DateTime @default(now())

  @@unique([zoneId, phone, seasonStart])
}

// Mesero con código propio: los clientes que inscribe quedan a su nombre para el ranking.
model Waiter {
  id           String     @id @default(cuid())
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  name         String
  code         String // ej. LUIS, va en la URL de la pieza: ?m=LUIS
  active       Boolean    @default(true)
  createdAt    DateTime   @default(now())
  customers    Customer[]

  @@unique([restaurantId, code])
}

// Reto: de un restaurante (restaurantId) o de toda una zona, opcionalmente patrocinado (zoneId sin restaurantId).
model Challenge {
  id           String                @id @default(cuid())
  restaurantId String?
  restaurant   Restaurant?           @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  zoneId       String?
  zone         Zone?                 @relation(fields: [zoneId], references: [id], onDelete: Cascade)
  title        String
  description  String?
  kind         ChallengeKind
  target       Int
  bonusPoints  Int
  sponsorName  String?
  startsAt     DateTime
  endsAt       DateTime
  active       Boolean               @default(true)
  createdAt    DateTime              @default(now())
  completions  ChallengeCompletion[]

  @@index([restaurantId, active])
  @@index([zoneId, active])
}

model ChallengeCompletion {
  id            String    @id @default(cuid())
  challengeId   String
  challenge     Challenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  phone         String
  customerId    String // registro del cliente donde se acreditaron los puntos
  pointsAwarded Int
  createdAt     DateTime  @default(now())

  @@unique([challengeId, phone])
}

// Factura premiada: cada compra validada durante el periodo genera una boleta.
// Solo puede activarse con número de autorización de Coljuegos (ver scripts/red.js).
model Draw {
  id                     String       @id @default(cuid())
  zoneId                 String? // null = toda la red
  zone                   Zone?        @relation(fields: [zoneId], references: [id], onDelete: SetNull)
  name                   String
  prizeText              String
  sponsorName            String?
  startsAt               DateTime
  endsAt                 DateTime
  drawAt                 DateTime
  coljuegosAuthorization String?
  termsUrl               String?
  status                 DrawStatus   @default(DRAFT)
  winnerTicketId         String?
  drawnAt                DateTime?
  createdAt              DateTime     @default(now())
  tickets                DrawTicket[]
}

model DrawTicket {
  id         String   @id @default(cuid())
  drawId     String
  draw       Draw     @relation(fields: [drawId], references: [id], onDelete: Cascade)
  number     Int
  purchaseId String   @unique
  purchase   Purchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  phone      String
  createdAt  DateTime @default(now())

  @@unique([drawId, number])
  @@index([drawId, phone])
}
