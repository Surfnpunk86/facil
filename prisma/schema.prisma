// Fácil — modelo de datos del MVP (fase 1)
// Montos en pesos colombianos enteros (sin decimales).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Door {
  NFC
  QR
  WHATSAPP
  WALLET
  CASHIER
  DELIVERY_CODE
}

enum Validation {
  INVOICE
  CASHIER
  DELIVERY_CODE
}

enum StaffRole {
  OWNER
  CASHIER
}

enum RewardKind {
  STAMP_CARD
  BIRTHDAY
}

enum RewardStatus {
  AVAILABLE
  REDEEMED
  EXPIRED
}

enum AutomationKey {
  WELCOME
  WINBACK
  BIRTHDAY
  NEAR_REWARD
  LOW_RATING
}

model Restaurant {
  id                 String   @id @default(cuid())
  slug               String   @unique
  name               String
  nit                String // solo dígitos, sin dígito de verificación
  city               String?
  pointsPerThousand  Int      @default(1) // puntos por cada $1.000 COP
  stampsGoal         Int      @default(8)
  rewardText         String   @default("Premio del Club")
  birthdayRewardText String   @default("Un detalle de cumpleaños por la casa")
  googleReviewUrl    String?
  ownerAlertPhone    String? // recibe alertas de calificaciones bajas
  maxClaimsPerDay    Int      @default(2) // compras validadas por cliente por día
  invoiceMaxAgeHours Int      @default(48)
  createdAt          DateTime @default(now())

  staff         Staff[]
  tags          Tag[]
  customers     Customer[]
  purchases     Purchase[]
  deliveryCodes DeliveryCode[]
  feedback      Feedback[]
  automations   Automation[]
  entries       EntryEvent[]
  messages      MessageLog[]
  rewards       Reward[]
}

model Staff {
  id           String     @id @default(cuid())
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  name         String
  email        String     @unique
  passwordHash String
  role         StaffRole  @default(CASHIER)
  createdAt    DateTime   @default(now())
  purchases    Purchase[]
}

// Pieza física de mesa o caja: chip NFC + QR impreso con la misma URL.
model Tag {
  id           String       @id @default(cuid())
  restaurantId String
  restaurant   Restaurant   @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  code         String // ej. MESA-7, CAJA-1
  label        String?
  active       Boolean      @default(true)
  createdAt    DateTime     @default(now())
  entries      EntryEvent[]

  @@unique([restaurantId, code])
}

model Customer {
  id            String    @id @default(cuid())
  restaurantId  String
  restaurant    Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  name          String?
  phone         String // formato E.164, ej. +573005551234
  birthMonth    Int?
  birthDay      Int?
  consentAt     DateTime? // autorización Ley 1581; sin ella no se envía marketing
  consentVersion String?
  optOut        Boolean   @default(false)
  cardToken     String    @unique
  points        Int       @default(0)
  stamps        Int       @default(0)
  rewardsEarned Int       @default(0)
  visits        Int       @default(0)
  totalSpent    Int       @default(0)
  firstVisitAt  DateTime?
  lastVisitAt   DateTime?
  joinedVia     Door?
  createdAt     DateTime  @default(now())

  purchases Purchase[]
  rewards   Reward[]
  feedback  Feedback[]
  entries   EntryEvent[]
  messages  MessageLog[]

  @@unique([restaurantId, phone])
  @@index([restaurantId, lastVisitAt])
}

model Purchase {
  id            String     @id @default(cuid())
  restaurantId  String
  restaurant    Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  customerId    String
  customer      Customer   @relation(fields: [customerId], references: [id], onDelete: Cascade)
  amount        Int
  door          Door
  validation    Validation
  invoiceKey    String? // CUFE o CUDE; evita que una factura se use dos veces
  invoiceNumber String?
  pointsAwarded Int
  stampAwarded  Boolean    @default(true)
  staffId       String?
  staff         Staff?     @relation(fields: [staffId], references: [id])
  createdAt     DateTime   @default(now())

  @@unique([restaurantId, invoiceKey])
  @@index([restaurantId, createdAt])
  @@index([customerId, createdAt])
}

// Código impreso en empaques de domicilio: una compra, un uso.
model DeliveryCode {
  id           String     @id @default(cuid())
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  code         String     @unique
  amount       Int
  usedAt       DateTime?
  customerId   String?
  expiresAt    DateTime
  createdAt    DateTime   @default(now())
}

model Reward {
  id           String       @id @default(cuid())
  restaurantId String
  restaurant   Restaurant   @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  customerId   String
  customer     Customer     @relation(fields: [customerId], references: [id], onDelete: Cascade)
  kind         RewardKind
  description  String
  status       RewardStatus @default(AVAILABLE)
  expiresAt    DateTime?
  redeemedAt   DateTime?
  createdAt    DateTime     @default(now())

  @@index([customerId, status])
}

model Feedback {
  id           String     @id @default(cuid())
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  customerId   String?
  customer     Customer?  @relation(fields: [customerId], references: [id], onDelete: SetNull)
  rating       Int
  comment      String?
  handledAt    DateTime?
  createdAt    DateTime   @default(now())
}

model Automation {
  restaurantId String
  restaurant   Restaurant    @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  key          AutomationKey
  enabled      Boolean       @default(true)

  @@id([restaurantId, key])
}

// Cada identificación en una puerta (toque NFC, QR, WhatsApp…), con o sin compra.
model EntryEvent {
  id           String     @id @default(cuid())
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  customerId   String?
  customer     Customer?  @relation(fields: [customerId], references: [id], onDelete: SetNull)
  tagId        String?
  tag          Tag?       @relation(fields: [tagId], references: [id], onDelete: SetNull)
  door         Door
  createdAt    DateTime   @default(now())

  @@index([restaurantId, createdAt])
}

model MessageLog {
  id           String     @id @default(cuid())
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  customerId   String?
  customer     Customer?  @relation(fields: [customerId], references: [id], onDelete: SetNull)
  kind         String // WELCOME, WINBACK, BIRTHDAY, NEAR_REWARD, CARD_LINK, PURCHASE, LOW_RATING_ALERT, REPLY
  channel      String     @default("WHATSAPP")
  status       String // SENT, FAILED, SKIPPED_DEV
  providerId   String?
  error        String?
  createdAt    DateTime   @default(now())

  @@index([customerId, kind, createdAt])
}
