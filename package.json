{
  "name": "facil",
  "version": "0.1.0",
  "private": true,
  "description": "Fácil — plataforma de fidelización para restaurantes, bares, cafés y panaderías (MVP fase 1)",
  "type": "module",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env --watch server/index.js",
    "dev:web": "npm --prefix web run dev",
    "build": "npm --prefix web ci --include=dev && npm --prefix web run build && prisma generate",
    "vercel-build": "npm --prefix web ci --include=dev && npm --prefix web run build && prisma generate",
    "start": "prisma migrate deploy && node server/index.js",
    "migrate:dev": "prisma migrate dev",
    "seed": "node --env-file-if-exists=.env prisma/seed.js",
    "automations": "node --env-file-if-exists=.env server/jobs/automations.js",
    "test": "node --test test/*.test.js"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "bcryptjs": "^3.0.2",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "express-rate-limit": "^8.1.0",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.16.3",
    "prisma": "7.10.0",
    "zod": "^3.25.76"
  }
}
